{
  "__inputs": [],
  "__requires": [],
  "title": "RecoStack — System Overview",
  "uid": "recostack-overview",
  "tags": ["recostack", "recommendation-system"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(recostack_http_requests_total[1m]))",
          "legendFormat": "All endpoints"
        },
        {
          "expr": "sum(rate(recostack_http_requests_total{endpoint=~\"/recommend|/rate|/health\"}[1m])) by (endpoint)",
          "legendFormat": "{{ endpoint }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "HTTP Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(recostack_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(recostack_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(recostack_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(recostack_http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Recommendation Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(recostack_recommend_latency_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(recostack_recommend_latency_seconds_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(recostack_recommend_latency_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Recommendation Candidates",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(recostack_recommend_candidates_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(recostack_recommend_candidates_bucket[1m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Rate Events / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(recostack_rate_events_total[1m])) by (status)",
          "legendFormat": "{{ status }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "System Health",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "recostack_models_ready",
          "legendFormat": "Models Ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Feast Available",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 16 },
      "targets": [
        {
          "expr": "recostack_feast_available",
          "legendFormat": "Feast"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Redpanda Connected",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "recostack_redpanda_connected",
          "legendFormat": "Redpanda"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Feature Lookup Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(recostack_feature_lookup_duration_seconds_bucket{entity_type=\"user\"}[1m]))",
          "legendFormat": "user"
        },
        {
          "expr": "histogram_quantile(0.95, rate(recostack_feature_lookup_duration_seconds_bucket{entity_type=\"movie\"}[1m]))",
          "legendFormat": "movie"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Recommendation Errors",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 20, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(recostack_recommend_errors_total[1m])) by (reason)",
          "legendFormat": "{{ reason }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    }
  ]
}