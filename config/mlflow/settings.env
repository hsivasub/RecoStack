# MLflow Tracking Server — Environment Variables
#
# Reference: https://mlflow.org/docs/latest/tracking.html#running-a-tracking-server
#
# These are the defaults used by the Dockerfile.
# Override any variable at `docker run` time with -e.

# Where MLflow stores run metadata (params, metrics, tags, etc.)
# SQLite is sufficient for single-user / local dev.
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db

# Where MLflow stores artifacts (models, plots, files)
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# Host / port for the Tracking Server
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000